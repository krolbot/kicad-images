FROM linuxserver/kicad:10.0.3-r0-ls151@sha256:27683df5f08133af07588900e1bd8440a9cc3c7e77a5bcfc6bab652f9b185665

ARG KIKIT_VERSION=1.8.1
ARG PCBDRAW_VERSION=1.3.0

USER root
RUN apk add --no-cache \
        graphviz \
        imagemagick \
        ngspice \
        openscad \
        py3-cairo \
        py3-lxml \
        py3-numpy \
        py3-pip \
        py3-shapely \
        py3-virtualenv \
    && python3 -m venv --system-site-packages /opt/kicad-tools \
    && /opt/kicad-tools/bin/pip install --no-cache-dir \
        "kikit==${KIKIT_VERSION}" \
        "pcbdraw==${PCBDRAW_VERSION}" \
    && chmod -R a+rX /opt/kicad-tools

ENV PATH="/opt/kicad-tools/bin:${PATH}" \
    PYTHONPATH="/opt/kicad-tools/lib/python3.14/site-packages"