@@ -5464,6 +5464,44 @@ def _fix_displaced_fp_text(pcb_path: str) -> int:
 _AUTOROUTE = ToolAnnotations(read_only_hint=False, open_world_hint=True)
 
 
+def _copper_geometry(node) -> bytes:
+    """Copper bytes without board-local identity and net spelling."""
+    copy = node.copy()
+    for head in ("uuid", "tstamp", "net"):
+        for child in copy.find_all(head):
+            copy.remove_child(child)
+    return _cst.serialize(copy)
+
+
+def _selected_routes(source: bytes, routed_path: str, nets: list[str]) -> bytes:
+    """Preserve every source node and append only new selected-net copper."""
+    doc = _cst.parse(source)
+    root = doc.lists[0]
+    routed = _cst.parse(_read_kicad_bytes(routed_path, "routed board")).lists[0]
+    selected = set(nets)
+    copper = {"segment", "arc", "via"}
+    source_copper = [
+        node for node in root.lists
+        if node.head in copper and _net_name_of(root, node) in selected
+    ]
+    identities = {_uuid_text(node) for node in source_copper if _uuid_text(node)}
+    geometries = {_copper_geometry(node) for node in source_copper}
+    for node in routed.lists:
+        if node.head not in copper or (name := _net_name_of(routed, node)) not in selected:
+            continue
+        identity = _uuid_text(node)
+        geometry = _copper_geometry(node)
+        if (identity and identity in identities) or geometry in geometries:
+            continue
+        copy = node.copy()
+        _set_item_net(copy, root, _resolve_net_cst(root, name))
+        root.append_child(copy, b"\n\t")
+        if identity:
+            identities.add(identity)
+        geometries.add(geometry)
+    return _cst.serialize(doc)
+
+
