#!/bin/sh
set -eu
unset PYTHONPATH
export PYTHONNOUSERSITE=1
if [ "$(id -u)" = 0 ]; then
  exec /command/s6-setuidgid abc "$0" "$@"
fi
set -- /usr/bin/xvfb-run -a -e /dev/stderr \
  -s "-screen 0 1280x720x24 -nolisten tcp" \
  /opt/kicad-mcp/bin/python /usr/local/share/kicad/mcp_http.py "$@"
setsid "$@" &
child=$!
forward_term() {
  kill -TERM "-$child" 2>/dev/null || true
}
trap forward_term HUP INT TERM
set +e
wait "$child"
status=$?
if kill -0 "$child" 2>/dev/null; then
  wait "$child"
fi
exit "$status"
